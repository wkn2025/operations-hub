# npm run dev forces PORT=3001 for the API (web dev server on 5173 proxies /api to it)
PORT=3000
DATA_DIR=./data
AUTH_MODE=dev
SESSION_SECRET=change-me-to-a-long-random-string-32+
ADMIN_BOOTSTRAP_EMAILS=admin@demo.test
# dev auth requires NODE_ENV=development (or test); set production + AUTH_MODE=oidc when deployed
NODE_ENV=development
# OIDC (AUTH_MODE=oidc, Entra ID)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Serve a built web app from the API (default in production: apps/web/dist when it exists)
# WEB_DIST=
# npm run backup / npm run export targets (default: backups/ and exports/ in the repo root)
# BACKUP_DIR=
# EXPORT_DIR=
